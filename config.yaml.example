# Meridian Capital Partners — Runtime Configuration
# Copy this file to config.yaml and adjust per-machine values.
# config.yaml is gitignored; config.yaml.example is committed.
#
# Secrets do NOT live here — they live in .env (see .env.example).
# Pydantic-settings validates this file at startup; bad values fail loud.

data:
  provider: yfinance        # yfinance (v1 default) | polygon | tiingo | iex
  universe_mode: liquid_us  # sp500 | liquid_us | scanner_seed
  lookback_years: 3
  benchmark: SPY
  cache_dir: cache
  # Benchmark + sector-ETF + macro tickers (DATA-02). NEVER hardcode in source.
  benchmarks: [SPY, QQQ, IWM, DIA]
  sector_etfs: [XLK, XLF, XLV, XLE, XLI, XLC, XLY, XLP, XLB, XLRE, XLU]
  macro_tickers: ["^VIX", TLT, HYG]
  yfinance_max_workers: 8        # ThreadPoolExecutor concurrency for yfinance OHLCV fetch

  # liquid_us universe-mode thresholds (DATA-01)
  liquid_us:
    exchanges: [NYSE, NASDAQ]
    min_price: 5.0
    min_avg_dollar_volume_20d: 10000000.0
    min_market_cap: 500000000.0

  # scanner_seed universe-mode tickers (50 mega-caps, 5 per GICS sector)
  scanner_seed_tickers:
    # XLK (Information Technology)
    - AAPL
    - MSFT
    - NVDA
    - AVGO
    - ORCL
    # XLF (Financials)
    - JPM
    - BAC
    - WFC
    - GS
    - MS
    # XLV (Health Care)
    - UNH
    - JNJ
    - LLY
    - ABBV
    - PFE
    # XLE (Energy)
    - XOM
    - CVX
    - COP
    - EOG
    - SLB
    # XLI (Industrials)
    - GE
    - HON
    - CAT
    - RTX
    - UPS
    # XLC (Communication Services)
    - META
    - GOOGL
    - DIS
    - CMCSA
    - NFLX
    # XLY (Consumer Discretionary)
    - AMZN
    - TSLA
    - HD
    - MCD
    - NKE
    # XLP (Consumer Staples)
    - PG
    - KO
    - PEP
    - COST
    - WMT
    # XLB (Materials)
    - LIN
    - SHW
    - APD
    - ECL
    - FCX
    # XLU (Utilities)
    - NEE
    - DUK
    - SO
    - AEP
    - D

  # 13F tracked-fund universe (DATA-07). Names + public CIKs.
  # CLAUDE.md anti-recommendation: fund names live in config, NOT hardcoded.
  tracked_funds:
    - { name: "Berkshire Hathaway",         cik: "0001067983" }
    - { name: "Citadel Advisors",           cik: "0001423053" }
    - { name: "Point72 Asset Management",   cik: "0001603466" }
    - { name: "Bridgewater Associates",     cik: "0001350694" }
    - { name: "Tiger Global Management",    cik: "0001167483" }
    - { name: "Third Point",                cik: "0001040273" }
    - { name: "Appaloosa Management",       cik: "0001656456" }
    - { name: "Baupost Group",              cik: "0001061768" }
    - { name: "Pershing Square Capital",    cik: "0001336528" }

broker:
  paper_host: 127.0.0.1
  paper_port: 7497          # IBKR paper TWS default
  live_port: 7496           # IBKR live TWS default
  client_id: 17
  mode: paper               # paper | live (live requires MERIDIAN_LIVE_OK=1 + AUDIT-03)
  audit_promotion_path: .audit/AUDIT-03-live-promotion.json

risk:
  factor_model_window_days: 120
  veto_checks:
    - halt_lock
    - earnings_blackout
    - liquidity_adv
    - position_max
    - sector_max
    - exposure_bounds
    - net_beta
    - pairwise_correlation
  breakers:
    daily_loss_pct: -1.5
    daily_loss_pct_hard: -2.5
    weekly_loss_pct: -4.0
    drawdown_pct: -8.0
    single_position_pct: 3.0

portfolio:
  optimizer: conviction      # conviction (Phase 5 default) | mvo (Phase 7 swap-in)
  num_longs: 20
  num_shorts: 20
  max_position_pct: 0.05
  max_sector_pct: 0.25
  gross_target: 1.50
  net_target_low: 0.0
  net_target_high: 0.10
  max_beta: 0.15
  turnover_budget: 0.30
  mvo_risk_aversion: 1.0
  adv_cap_pct: 0.05                # PORT-01: position <= 5% of 20-day ADV
  adv_lookback_days: 20
  earnings_halve_window_days: 5    # PORT-01: halve size if earnings within N days
  beta_lookback_days: 60           # PORT-07: rolling 60-day beta vs SPY
  target_aum_usd: 1000000          # used by --whatif when no positions exist yet
  transaction_cost:                # PORT-04: broker-configurable, NOT hardcoded $0
    commission_model: ibkr_tiered  # ibkr_tiered | ibkr_lite | fixed_per_share | zero
    cents_per_share: 0.35
    min_commission_usd: 0.35
    max_commission_pct_of_trade: 0.01
    fixed_per_share_cents: 0.5
    sec_fee_bps: 0.27              # 0.0027% on sells/short-covers
    avg_spread_bps: 4.0
    impact_coef_bps: 10.0          # impact = coef * sqrt(trade_value / adv_usd)

execution:
  limit_price_policy: signal        # signal | close | market_reference
  tif: DAY
  max_chunks: 5
  chunk_skip_adv_pct: 0.01          # <1% ADV: no chunking
  chunk_defer_adv_pct: 0.05         # >5% ADV: defer to next day
  order_timeout_seconds: 30
  borrow_rate_skip_pct: 25.0        # refuse new shorts above 25%/yr borrow
  htb_rate_pct: 10.0                # hard-to-borrow flag threshold

reporting:
  risk_free_rate: 0.0
  commentary_weekday: 4             # Friday, Python weekday
  fund_aum_usd: 1000000
  domicile: Delaware
  tax:
    jurisdiction_name: configurable
    short_term_rate: 0.0
    long_term_rate: 0.0

anthropic:
  model: claude-sonnet-4-5
  cost_ceiling_usd: 25
  cache_ttl_days: 30
  prompt_caching: true
  max_candidates: 40

logging:
  level: INFO
  log_dir: logs
  json_renderer_when_non_tty: true
  redact_keys:
    - api_key
    - apikey
    - password
    - passwd
    - token
    - secret
    - authorization
    - auth
    - key
