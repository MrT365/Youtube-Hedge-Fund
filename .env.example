# Meridian Capital Partners — Secrets
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed.

# Anthropic Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Interactive Brokers credentials (paper TWS / Gateway)
# These are NEVER read by the bot for live login — TWS handles auth.
# Stored here only for documentation + future Client Portal API path.
IBKR_USERNAME=REPLACE_ME
IBKR_PASSWORD=REPLACE_ME

# SEC EDGAR User-Agent — REQUIRED. EDGAR returns 403 without it.
# Format: "<Name or org> <contact email>"
SEC_USER_AGENT=Meridian Capital Partners contact@example.com

# Live-trading gate (Phase 8). DO NOT SET to 1 in v1 paper-only.
# MERIDIAN_LIVE_OK=0
